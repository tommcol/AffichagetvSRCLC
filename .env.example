# Exemple de variables d’environnement pour le développement local.
# En production, ces secrets sont configurés dans le tableau de bord Cloudflare (Worker > Settings > Variables and Secrets) :
# ADMIN_PASSWORD, TELEGRAM_BOT_TOKEN, GEMINI_API_KEY, APP_URL.

# GEMINI_API_KEY : requis pour la génération des légendes IA (Google Gemini).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL : URL où l’application est hébergée (ex : https://affichagetv-src-basket.workers.dev).
# Utilisée pour les liens internes et les webhooks.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN : optionnel, token du bot Telegram (obtenu via @BotFather).
TELEGRAM_BOT_TOKEN=""

# ADMIN_PASSWORD : mot de passe requis pour la sauvegarde d’administration.
ADMIN_PASSWORD=""
